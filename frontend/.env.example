# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Supabase Auth (client-side) ---
# Supabase dashboard -> Project Settings -> API
# VITE_SUPABASE_URL is the Project URL (same project as the backend's SUPABASE_URL).
# VITE_SUPABASE_PUBLISHABLE_KEY is the "anon"/"publishable" key (NOT the service_role/secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Google Drive import ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Use the *Web application* client id (the same one Supabase's Google provider
# uses is fine). Client ids are public — never put the client secret here.
#
# Add your app origins (e.g. http://localhost:5173 and your deployed URL) under
# that client's "Authorized JavaScript origins", and enable the Google Drive API
# for the project.
#
# Leave blank to fall back to the older Supabase provider_token flow, which
# breaks once the login session refreshes.
VITE_GOOGLE_CLIENT_ID=

# --- Google Picker (Drive file browser) ---
# Google Cloud Console -> APIs & Services -> Credentials -> API Keys.
# These are public browser keys (safe to ship in the bundle), but restrict them
# to your app's HTTP referrers and to the Picker/Drive APIs in the console.
# VITE_GOOGLE_API_KEY / VITE_GOOGLE_PICKER_API_KEY are the API key (often the
#   same value) the Picker widget uses.
# VITE_GOOGLE_PICKER_APP_ID is the Google Cloud *project number* — it MUST be
#   the same project the OAuth client above lives in, or the Picker 403s.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=

# --- Backend API base URL ---
# Optional. Defaults to http://localhost:4000 if not set — only override this
# if your backend is running somewhere else (a different port, a deployed URL, etc.).
VITE_API_BASE_URL=
