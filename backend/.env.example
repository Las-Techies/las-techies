# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL is the pooled/transaction connection string Prisma uses at runtime.
# DIRECT_URL is the direct connection string Prisma uses for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth (server-side) ---
# Supabase dashboard -> Project Settings -> API
# SUPABASE_URL is the Project URL.
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (NOT the anon/publishable key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Salesforce Express LLM Gateway (internal) ---
# Only needed for AI quiz generation. Requires Salesforce internal access
# (DevBar) to obtain a personal key. If you don't have access, leave these
# blank — the rest of the app (login, uploads, browsing) still works; only
# "Generate quiz" will fail with a clear "LLM gateway is not configured" error.
LLM_GATEWAY_URL=
ENG_AI_MODEL_GW_KEY=

# --- GitHub repo import ---
# The "Pick from GitHub" importer connects each manager's OWN GitHub account
# via OAuth, so they see their own repos. Register a GitHub OAuth App at
# https://github.com/settings/developers -> New OAuth App:
#   Authorization callback URL: <API_URL>/github/oauth/callback
#     (e.g. http://localhost:4000/github/oauth/callback in dev)
# then copy the Client ID and generate a Client Secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 32-byte key used to encrypt stored GitHub tokens at rest AND sign the OAuth
# state parameter. Generate with `openssl rand -hex 32`. Required for the GitHub
# connect flow; changing it invalidates all existing connections.
GITHUB_TOKEN_ENC_KEY=

# Legacy shared server token (fine-grained PAT). No longer used by the importer
# now that connections are per-user; kept only for any older code paths. Safe to
# leave blank.
GITHUB_TOKEN=

# --- Email invites (Gmail SMTP) ---
# Used to send team-invite emails. GMAIL_USER is the sending Gmail address;
# GMAIL_APP_PASSWORD is a Google *App Password* (NOT your account password) —
# create one at https://myaccount.google.com/apppasswords (requires 2FA on).
# Leave blank to disable invite emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- URLs ---
# APP_URL is the frontend's public URL — used to build email links, as the
# postMessage target for the GitHub OAuth popup, and to pick the LLM provider
# (localhost => Salesforce gateway; anything else => OpenRouter).
APP_URL=http://localhost:5173
# API_URL is THIS backend's public URL — used to build the GitHub OAuth
# redirect_uri, which must match the OAuth App's callback URL exactly.
API_URL=http://localhost:4000
# Origin allowed to call this API from the browser (CORS). Set to your frontend
# URL (e.g. http://localhost:5173 in dev, your deployed frontend URL in prod).
CORS_ORIGIN=http://localhost:5173

# --- Optional ---
# Port the Express API listens on. Defaults to 4000 if not set.
PORT=4000
