# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL is the pooled/transaction connection string Prisma uses at runtime.
# DIRECT_URL is the direct connection string Prisma uses for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth (server-side) ---
# Supabase dashboard -> Project Settings -> API
# SUPABASE_URL is the Project URL.
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (NOT the anon/publishable key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Salesforce Express LLM Gateway (internal) ---
# Only needed for AI quiz generation. Requires Salesforce internal access
# (DevBar) to obtain a personal key. If you don't have access, leave these
# blank — the rest of the app (login, uploads, browsing) still works; only
# "Generate quiz" will fail with a clear "LLM gateway is not configured" error.
LLM_GATEWAY_URL=
ENG_AI_MODEL_GW_KEY=

# --- GitHub repo import ---
# Personal access token used server-side to list and read repositories for the
# "Pick from GitHub" importer. Supabase never hands the browser a usable GitHub
# token, so this listing runs on the server with this token instead.
#
# Create one at https://github.com/settings/tokens?type=beta (fine-grained):
#   Repository access -> the repos you import from (or All repositories)
#   Permissions -> Repository -> Contents: Read-only  (the only scope needed)
# Fine-grained tokens start with `github_pat_`; classic tokens with `ghp_`.
#
# Each developer should use their OWN token; production should use a shared
# service/bot account's token, not any individual's personal one.
# Leave blank to disable GitHub import.
GITHUB_TOKEN=

# --- Email invites (Gmail SMTP) ---
# Used to send team-invite emails. GMAIL_USER is the sending Gmail address;
# GMAIL_APP_PASSWORD is a Google *App Password* (NOT your account password) —
# create one at https://myaccount.google.com/apppasswords (requires 2FA on).
# Leave blank to disable invite emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- CORS ---
# Origin allowed to call this API from the browser. Set to your frontend URL
# (e.g. http://localhost:5173 in dev, your deployed frontend URL in prod).
CORS_ORIGIN=http://localhost:5173

# --- Optional ---
# Port the Express API listens on. Defaults to 4000 if not set.
PORT=4000
